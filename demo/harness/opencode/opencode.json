{
  "$schema": "https://opencode.ai/config.json",
  "model": "nebius/openai/gpt-oss-120b",
  "small_model": "nebius/openai/gpt-oss-120b",
  "provider": {
    "nebius": {
      "npm": "GENERATED_BY_LAUNCHER",
      "name": "Nebius Token Factory",
      "options": {
        "baseURL": "https://api.tokenfactory.nebius.com/v1/"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "gpt-oss-120b (dev default)"
        },
        "deepseek-ai/DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek-V4-Pro-0813"
        },
        "moonshotai/Kimi-K3": {
          "name": "Kimi-K3"
        },
        "Qwen/Qwen3.8-27B": {
          "name": "Qwen3.8-27B"
        },
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3"
        }
      }
    },
    "spark-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark Qwen3.8-Flash-Next (local vLLM)",
      "options": {
        "baseURL": "http://127.0.0.1:18300/v1"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8-Flash-Next",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "enabled_providers": [
    "nebius",
    "spark-qwen"
  ],
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "watcher": {
    "ignore": [
      "**/.venv*/**",
      "**/node_modules/**",
      "harness/opencode/**",
      "harness/planning_runs/**",
      "harness/paperclip/private/**"
    ]
  },
  "agent": {
    "stage": {
      "description": "Live stage demo agent: knowledge-graph grounding, experiment proposal, plate and robot panels.",
      "mode": "primary",
      "prompt": "{file:../stage/agent_prompt.md}",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "apply_patch": false,
        "read": false,
        "grep": false,
        "glob": false,
        "webfetch": false,
        "websearch": false,
        "task": false,
        "todowrite": false,
        "skill": false,
        "question": false,
        "literature_search": false,
        "literature_read": false,
        "planning_context": false,
        "planning_submit": false,
        "planning_simulate": false,
        "biology_lookup": false
      }
    },
    "planner": {
      "description": "Real-data literature-grounded multi-species, multi-compound experiment planner.",
      "mode": "primary",
      "prompt": "{file:../stage/planner_prompt.md}",
      "tools": {
        "*": false,
        "literature_search": true,
        "literature_read": true,
        "planning_context": true,
        "planning_submit": true,
        "planning_simulate": true,
        "biology_lookup": true
      }
    }
  }
}
